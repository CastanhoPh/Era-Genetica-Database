rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && (
        request.auth.uid == '5Eo9GEhVMGgfmvKgDt68H5lBlcw2' ||
        request.auth.uid == 'QWQHFo4xUxevsRZronUVa1IzJTc2'    // Claude (QA)
      );
    }

    // Checklist de produção de imagens: só o admin e os dois amigos autorizados
    // (Liu e Zeck) podem marcar/editar/reorganizar/criar/apagar itens.
    function isChecklistEditor() {
      return request.auth != null && (
        isAdmin() ||
        request.auth.uid == 'G2YvfxwlWoRz2TH878cnugTi8gi1' || // Liu
        request.auth.uid == 'csE07Qq2LLaUwg3wYSeNXWbVrE73'    // Zeck
      );
    }

    // IMPORTANTE: no Firestore as regras se SOMAM — basta uma permitir para a
    // operação ser liberada, e uma regra específica não consegue restringir o que
    // um `match /{document=**}` amplo já abriu. Por isso não existe mais curinga
    // de leitura aqui: cada coleção pública é listada uma a uma, e o que não
    // estiver listado fica negado por padrão. Ao criar uma coleção nova, lembrar
    // de liberar a leitura dela aqui se o site precisar.

    match /characters/{docId} {
      allow read: if true;        // qualquer um vê as fichas
      allow write: if isAdmin();
    }

    match /arsenal/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /familyTrees/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /imageChecklist/{docId} {
      allow read: if true;
      allow write: if isChecklistEditor();
    }

    // Rascunhos de personagens que ainda não entraram na história — spoiler puro.
    // Só o admin lê, que é exatamente quem já conseguia vê-los: a aba "Protótipo"
    // vive no Painel, e o Painel redireciona quem não é admin (App.tsx). Se algum
    // dia o Liu ou o Zeck precisarem ver, trocar por isChecklistEditor().
    match /prototypeEntries/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Lista de pendências do Painel. Anotação interna do Pedro, não conteúdo do site —
    // mesma postura dos protótipos: ninguém além do admin lê.
    match /aFazer/{docId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
